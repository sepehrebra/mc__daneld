{
	# TLS is handled by the shared edge Caddy; this one only speaks plain HTTP behind it.
	auto_https off
	servers {
		# Trust X-Forwarded-* from the edge (private Docker network), so Django still
		# sees the original https scheme and the real client IP.
		trusted_proxies static private_ranges
	}
}

http://{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API goes to Django (same origin, so no CORS needed)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else is the React SPA, falling back to index.html for client-side routes
	handle {
		root * /srv
		# Vite fingerprints files under /assets, so they can be cached for a year
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# The www -> bare-domain redirect moved to the edge Caddyfile.
